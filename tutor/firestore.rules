rules_version = '2';
// ─────────────────────────────────────────────────────────────
// All About Korea — Firestore 보안 규칙 (v3, 2026-11-12: 튜터 채팅 추가)
// 기존 규칙 대비 변경점은 [변경] 주석으로 표시. 현재 페이지 동작은 그대로 유지됩니다.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ═════════ 공통 함수 ═════════
    // [변경] 이메일 인증된 계정만 로그인으로 인정 (이메일 사칭 방지)
    function signedIn()   { return request.auth != null && request.auth.token.email != null
                                   && request.auth.token.email_verified == true; }
    function myEmail()    { return request.auth.token.email; }
    function isOwner()    { return signedIn() && myEmail() == "shchung0130@gmail.com"; }
    function hasRoleDoc() { return signedIn() && exists(/databases/$(database)/documents/roles/$(myEmail())); }
    function myRole()     { return get(/databases/$(database)/documents/roles/$(myEmail())).data; }
    function isAdmin()    { return isOwner() || (hasRoleDoc() && myRole().role == "admin"); }
    // [변경] 사이트 관리자 = 소유자 또는 admins/{uid}.role == "admin" (페이지 코드는 이 문서로 관리자 확인)
    function isSiteAdmin() {
      return isOwner() || (request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin");
    }
    function isTutorOf(tid) {
      return isAdmin() || (hasRoleDoc() && myRole().role == "tutor" && myRole().get("tutorId", "") == tid);
    }
    function isSelfTutor(tid) {
      return hasRoleDoc() && myRole().role in ["tutor", "admin"] && myRole().get("tutorId", "") == tid;
    }

    // ═════════ 북스토어 ═════════
    match /books/{bookId} {
      allow read: if true;
      allow write: if isSiteAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        // [변경] 리뷰 작성자 uid 를 본인으로만 기록 가능 (다른 사람 이름으로 리뷰 작성 차단)
        allow create: if isSiteAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);
        // [변경] 수정 시 uid 를 다른 사람으로 바꿀 수 없음
        allow update: if isSiteAdmin() || (signedIn()
          && resource.data.get("uid", "") == request.auth.uid
          && request.resource.data.get("uid", "") == request.auth.uid);
        allow delete: if isSiteAdmin() || (signedIn() && resource.data.get("uid", "") == request.auth.uid);
      }
    }

    // [변경] 구매 기록은 서버(verifyBookOrder)만 생성 — 결제 없이 구매 기록을 만드는 것 차단
    //        사용자는 "내 구매 목록에서 숨기기(hidden)"만 바꿀 수 있음
    match /purchases/{purchaseId} {
      allow read: if request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid || isSiteAdmin());
      allow create, delete: if isSiteAdmin();
      allow update: if isSiteAdmin() || (request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hidden"]));
    }

    // [신규] eBook 파일 저장 경로 (비공개) — 다운로드 링크는 서버(getBookDownloadUrl)가 구매자에게만 발급
    match /bookFiles/{bookId} {
      allow read, write: if isSiteAdmin();
    }

    // [신규] 결제 중복 사용 방지 기록, 미리보기 횟수 — 서버 전용
    match /paypalOrders/{id}  { allow read, write: if false; }
    match /lessonViews/{id}   { allow read, write: if false; }   // 조회수 중복 방지 기록 (서버 전용)
    match /previewQuota/{uid} { allow read, write: if false; }

    match /masterclass/{docId} {
      allow read: if true;            // 목록·제목·설명만 (강의 HTML 은 아래 비공개 문서)
      allow write: if isSiteAdmin();
    }

    // [신규] 강의 HTML (비공개) — 구독자·미리보기는 서버(getLessonContent)가 권한 확인 후 전달
    match /masterclassContent/{docId} {
      allow read, write: if isSiteAdmin();
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();   // 구독 상태는 서버(Cloud Functions)·소유자만 변경
    }

    // [변경] 찜 목록·찜 수는 서버(toggleLessonFavorite)만 변경 — 사용자는 읽기만
    match /userFavorites/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // [변경] 기존 규칙은 남의 학습 기록 문서를 내 uid 로 덮어쓸 수 있었음 → 본인 문서만 수정·삭제
    match /userProgress/{docId} {
      allow read: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid || isOwner());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ═════════ 튜터링 플랫폼 (기존과 동일) ═════════
    match /roles/{email} {
      allow read: if signedIn() && (myEmail() == email || isAdmin());
      allow create: if isAdmin() || (
        signedIn() && myEmail() == email
        && request.resource.data.role == "student"
        && request.resource.data.keys().hasOnly(["role", "email", "createdAt"])
      );
      allow update, delete: if isAdmin();
    }

    match /tutors/{tutorId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isTutorOf(tutorId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(["commission", "active", "rating", "reviewCount", "email", "tutorId"])
      );
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /tutorPrivate/{tutorId} {
      allow read, write: if isTutorOf(tutorId);
    }

    match /calBusy/{tutorId} {
      allow read: if true;
      allow write: if false;
    }

    match /customRates/{id} {
      allow get: if signedIn() && (resource == null || resource.data.email == myEmail() || isTutorOf(resource.data.tutorId));
      allow list: if signedIn() && (resource.data.email == myEmail() || isTutorOf(resource.data.tutorId));
      allow create, update: if isSelfTutor(request.resource.data.tutorId)
        && id == request.resource.data.tutorId + "__" + request.resource.data.email.lower();
      allow delete: if isSelfTutor(resource.data.tutorId);
    }

    match /orders/{id} {
      allow read: if signedIn() && (resource.data.studentEmail == myEmail() || isTutorOf(resource.data.tutorId));
      allow write: if false;
    }

    match /bookings/{id} {
      allow read: if signedIn() && (resource.data.studentEmail == myEmail() || isTutorOf(resource.data.tutorId));
      allow update: if isTutorOf(resource.data.tutorId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["meetLink", "tutorNote"]);
      allow create, delete: if false;
    }

    match /creditLogs/{id} {
      allow read: if signedIn() && (resource.data.studentEmail == myEmail() || isTutorOf(resource.data.tutorId));
      allow write: if false;
    }

    match /busySlots/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /materials/{id} {
      allow read: if signedIn() && (
        resource.data.studentEmail == myEmail()
        || resource.data.studentEmail == "all"
        || isTutorOf(resource.data.tutorId)
      );
      allow create: if false;   // [변경] 학습 자료 탭은 채팅으로 대체되었습니다
      allow delete: if isTutorOf(resource.data.tutorId);
      allow update: if false;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // [신규] 튜터 ↔ 학생 채팅방 — 서버(openChat)만 만들고, 참여자는 읽기·읽음 표시만 변경
    function myLower() { return request.auth.token.email.lower(); }
    function chatMember(d) { return signedIn() && (d.studentEmail == myLower() || isTutorOf(d.tutorId)); }
    match /chats/{chatId} {
      allow read: if chatMember(resource.data);
      allow create, delete: if false;
      allow update: if chatMember(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ["lastAt", "lastText", "lastFrom", "firstUnreadForTutorAt", "firstUnreadForStudentAt", "tutorReadAt", "studentReadAt"]);
    }
    // [신규] 채팅 메시지 — 30일 후 서버가 자동 삭제 (expireAt), 수정·삭제 불가
    match /chatMessages/{id} {
      allow read: if chatMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["chatId", "tutorId", "studentEmail", "from", "senderEmail", "senderName", "text", "file", "createdAt", "expireAt"])
        && request.resource.data.chatId == request.resource.data.tutorId + "__" + request.resource.data.studentEmail
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId))
        && request.resource.data.senderEmail == myLower()
        && ((request.resource.data.from == "student" && request.resource.data.studentEmail == myLower())
            || (request.resource.data.from == "tutor" && isTutorOf(request.resource.data.tutorId)))
        && request.resource.data.text is string && request.resource.data.text.size() <= 4000
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(31, "d");
      allow update, delete: if false;
    }
    // [신규] Google 계정 연결 토큰, 메일 발송 기록 — 서버 전용
    match /tutorSecrets/{tid} { allow read, write: if false; }
    match /mailState/{id}     { allow read, write: if false; }

    // [변경] 위에 없는 모든 컬렉션은 명시적으로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
